@article{duff2011a,
  title = {Teasing Apart Tangrams: {{Testing}} Hippocampal Pattern Separation with a Collaborative Referencing Paradigm},
  shorttitle = {Teasing Apart Tangrams},
  author = {Duff, Melissa C. and Warren, David E. and Gupta, Rupa and Vidal, Juan Pablo Benabe and Tranel, Daniel and Cohen, Neal J.},
  year = {2011},
  month = aug,
  journal = {Hippocampus},
  volume = {22},
  number = {5},
  pages = {1087--1091},
