  langid = {english},
  keywords = {read},
  file = {/home/vboyce/Zotero/storage/C3QI8J8W/Huang and Snedeker - 2009 - Online interpretation of scalar quantifiers Insight into the semantics–pragmatics interface.pdf}
}

