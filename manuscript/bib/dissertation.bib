@article{sanjuan2025,
  title = {Common Ground without Copresence: {{Preschoolers}} Apply Indirect Cues about Shared Knowledge in Real-Time Referential Interpretation},
  shorttitle = {Common Ground without Copresence},
  author = {San Juan, Valerie and Gibbard, Katherine and Morra, Sirine and Khu, Melanie and Chambers, Craig G. and Graham, Susan A.},
  year = {2025},
